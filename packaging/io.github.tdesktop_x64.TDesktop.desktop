[Desktop Entry]
Version=1.0
Name=64Gram
GenericName=Messenger
Comment=Unofficial Telegram Desktop build with extra features
Comment[zh_CN]=Telegram Desktop 的非官方增强版本
TryExec=64gram
Exec=64gram -- %U
Icon=64gram
Terminal=false
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
Keywords=telegram;tgram;chat;im;messaging;messenger;sms;tdesktop;64gram;
StartupNotify=false
StartupWMClass=64Gram
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true
Actions=quit;

[Desktop Action quit]
Name=Quit
Name[zh_CN]=退出
Exec=64gram -quit
Icon=application-exit
